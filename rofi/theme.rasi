* {
    bg:            #0d0707;
    bg-alt:        #1d1515;
    fg:            #f2d2d2;
    fg-dim:        #8a5a5a;
    accent:        #e51111;
    tint:          #260808;
    border:        #e51111;
    pad:           14px;
    spacing:       10px;
}

window {
    background-color: @bg;
    border:            1px;
    border-color:      @border;
    border-radius:     0px;
    padding:           0px;
    margin:            0px;
    width:             660px;
    location:          center;
    anchor:            center;
}

mainbox {
    background-color: transparent;
    border:            0px;
    padding:           @pad;
    spacing:           @spacing;
    children:          [ inputbar, listview, message ];
}

inputbar {
    background-color: @bg-alt;
    border:           0px;
    border-radius:    0px;
    padding:          12px 14px;
    spacing:          10px;
    children:         [ entry ];
}

entry {
    background-color:   transparent;
    text-color:         @fg;
    cursor-color:       @accent;
}

listview {
    background-color:   transparent;
    border:             0px;
    layout:             vertical;
    columns:            1;
    lines:              9;
    spacing:            8px;
    padding:            14px 0px 4px 0px;
    dynamic:            true;
    cycle:              true;
}

element {
    background-color: transparent;
    border:           0px;
    border-radius:    0px;
    padding:          10px 14px;
    margin:           0px;
    spacing:          12px;
    text-color:       @fg;
}

element selected {
    background-color: @tint;
    border:           0px;
    text-color:       @accent;
}

element-icon {
    background-color: transparent;
    size:             32px;
    padding:          0px;
    vertical-align:   center;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   center;
}

message {
    background-color: transparent;
    border:           0px;
    padding:          8px 0px 0px 0px;
    text-color:       @fg-dim;
}

error-message {
    background-color: @bg;
    border-radius:    0px;
    padding:          @pad;
    text-color:       @fg;
}
