/* =========================================================
   Waybar theme — generated by matugen from the wallpaper.
   Do not edit: this file is re-rendered on every wallpaper
   change (see modules/home/matugen.nix).
   ========================================================= */

@define-color m-background {{ colors.background.default.hex }};
@define-color m-surface     {{ colors.surface_container.default.hex }};
@define-color m-surface-hi  {{ colors.surface_container_high.default.hex }};
@define-color m-surface-var {{ colors.surface_variant.default.hex }};
@define-color m-text        {{ colors.on_background.default.hex }};
@define-color m-surface-txt {{ colors.on_surface.default.hex }};
@define-color m-muted       {{ colors.on_surface_variant.default.hex }};
@define-color m-outline     {{ colors.outline.default.hex }};
@define-color m-outline-var {{ colors.outline_variant.default.hex }};

@define-color m-primary        {{ colors.primary.default.hex }};
@define-color m-on-primary     {{ colors.on_primary.default.hex }};
@define-color m-primary-cont   {{ colors.primary_container.default.hex }};
@define-color m-on-primary-cont {{ colors.on_primary_container.default.hex }};
@define-color m-secondary      {{ colors.secondary.default.hex }};
@define-color m-on-secondary   {{ colors.on_secondary.default.hex }};
@define-color m-secondary-cont {{ colors.secondary_container.default.hex }};
@define-color m-on-secondary-cont {{ colors.on_secondary_container.default.hex }};
@define-color m-tertiary       {{ colors.tertiary.default.hex }};
@define-color m-on-tertiary    {{ colors.on_tertiary.default.hex }};
@define-color m-error          {{ colors.error.default.hex }};
@define-color m-on-error       {{ colors.on_error.default.hex }};
@define-color m-error-cont     {{ colors.error_container.default.hex }};
@define-color m-on-error-cont  {{ colors.on_error_container.default.hex }};

/* ============================= */
/* GLOBAL RESET */
/* ============================= */

* {
  font-family: "JetBrainsMono Nerd Font";
  font-size: 15px;
  font-weight: bold;
  min-height: 0;
  margin: 0;
  padding: 0;
}

box,
.modules-left,
.modules-center,
.modules-right {
  margin: 0;
  padding: 0;
}

/* ============================= */
/* WAYBAR WINDOW */
/* ============================= */

window#waybar {
  background-color: transparent;
  border: none;
  margin-top: 8px;
}

.modules-left,
.modules-center,
.modules-right {
  background-color: @m-background;
  border: 5px solid @m-background;
  border-radius: 5px;
}

/* ============================= */
/* MODULE BASE STYLE */
/* ============================= */

#tray, #window, #mpris, #cpu, #clock, #battery, #network,
#memory, #backlight, #bluetooth, #pulseaudio, #custom-weather,
#custom-update, #idle_inhibitor, #custom-omarchy, #custom-voxtype,
#custom-updatespacman {
  margin: 0 2px;
  padding: 0 8px;
  min-width: 14px;
  border-radius: 2px;
  transition: background-color 0.2s ease, color 0.2s ease;
}

/* ============================= */
/* WORKSPACES */
/* ============================= */

#workspaces button {
  margin: 0 2px 0 0;
  padding: 0 4px;
  border-radius: 2px;
  background-color: @m-surface;
  color: @m-muted;
  transition: background-color 0.2s ease, color 0.2s ease;
}

#workspaces button.active {
  background-color: @m-primary;
  color: @m-on-primary;
}

#workspaces button:hover {
  background-color: @m-tertiary;
  color: @m-on-tertiary;
}

/* ============================= */
/* WINDOW & LAUNCHER */
/* ============================= */

#window {
  background-color: @m-surface-hi;
  color: @m-surface-txt;
}

#custom-omarchy {
  background-color: @m-primary;
  color: @m-on-primary;
  font-size: 20px;
}

/* ============================= */
/* MODULE SECTIONS */
/* ============================= */

/* Priority info (CPU) */
#custom-update, #custom-updatespacman, #cpu {
  background-color: @m-primary-cont;
  color: @m-on-primary-cont;
}

/* Utility info (Clock/Tray) */
#clock, #idle_inhibitor, #custom-weather, #tray {
  background-color: @m-surface;
  color: @m-surface-txt;
}

/* System stats */
#battery, #network {
  background-color: @m-secondary-cont;
  color: @m-on-secondary-cont;
}

#memory, #backlight, #bluetooth {
  background-color: @m-surface-var;
  color: @m-muted;
}

#pulseaudio {
  background-color: @m-error-cont;
  color: @m-on-error-cont;
}

/* ============================= */
/* HOVER EFFECTS */
/* ============================= */

#clock:hover, #cpu:hover, #memory:hover, #battery:hover,
#network:hover, #pulseaudio:hover {
  background-color: @m-secondary;
  color: @m-on-secondary;
}

#custom-omarchy:hover, #custom-weather:hover, #tray:hover, #bluetooth:hover {
  background-color: @m-primary;
  color: @m-on-primary;
}

/* ============================= */
/* WARNINGS & CRITICAL */
/* ============================= */

#cpu.critical, #memory.critical, #battery.critical {
  background-color: @m-error;
  color: @m-on-error;
  animation: blink-warning 0.5s linear infinite alternate;
}

@keyframes blink-warning {
  to { background-color: @m-background; color: @m-error; }
}

/* ============================= */
/* TOOLTIP */
/* ============================= */

tooltip {
  background-color: @m-surface-hi;
  border: 1px solid @m-outline-var;
  border-radius: 4px;
}

tooltip label {
  color: @m-surface-txt;
}

#custom-idle-indicator.active,
#custom-notification-silencing-indicator.active {
  color: @m-error;
}