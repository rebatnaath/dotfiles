{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": { "type": "small", "padding": { "top": 1 } },
    "display": {
        "constants": ["██ "],
        "separator": "",
        "key": { "width": 8 }
    },
    "modules": [
        "break",
        { "type": "os", "key": "os", "keyColor": "yellow", "format": "{name} {version-id}" },
        { "type": "kernel", "key": "ker", "keyColor": "yellow", "format": "{release}" },
        {
    "type": "command",
    "key": "pkgs",
    "keyColor": "yellow",
    "text": "cnt() { awk '/(home\\.packages|environment\\.systemPackages|users\\.oryza\\.packages) = / || /^[[:space:]]*packages = with pkgs/ {p=1; next} p && /^[[:space:]]*]/ {p=0; next} p && /^[[:space:]]*[a-zA-Z0-9_.+*-]+/ {gsub(/[ ,]/,\"\",$0); if ($0!=\"\" && $0!~/inputs\\./ && $0!~/\\$/) c++} END {print c+0}' \"$1\"; }; s=$(cnt ~/nixConfig/hosts/nixos/configuration.nix); h=$(cnt ~/nixConfig/hosts/nixos/home.nix); printf '%s sys / %s user' \"$s\" \"$h\""
},
        { "type": "wm", "key": "wm", "keyColor": "yellow" },
        { "type": "command", "key": "ram", "keyColor": "yellow", "text": "free -m | awk 'NR==2 {print $3 \" / \" $2 \" MB\"}'" },
        { "type": "command", "key": "up", "keyColor": "yellow", "text": "awk '{printf \"%d min\", $1/60}' /proc/uptime" },
        {
            "type": "command",
            "key": " ",
            "text": "row=\"$(printf '\\033[93m󰮯\\033[0m  ')\"; for c in 31 35 36 33; do row=\"$row$(printf '\\033[%dm󰊠\\033[0m  ' $c)\"; done; printf '\\n              %s\\n' \"${row% }\""
        }
    ]
}
