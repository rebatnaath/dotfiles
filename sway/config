# Sway config

set $mod Mod4
set $terminal kitty
set $fileManager nautilus
set $menu rofi -show drun

### Output configuration
output * scale 1
# last chosen wallpaper (symlink kept fresh by theme-switch)
output * bg ~/.cache/current-wallpaper fill

### Idle configuration
# Lock after 5 min of inactivity, DPMS off after 10, re-lock before sleep.
exec swayidle -w \
    timeout 300 '$HOME/.config/sway/scripts/lock.sh' \
    timeout 600 'swaymsg "output * dpms off"' \
           resume 'swaymsg "output * dpms on"' \
    before-sleep '$HOME/.config/sway/scripts/lock.sh'

### Input configuration
input "type:touchpad" {
    tap enabled
    natural_scroll enabled
    dwt enabled
    pointer_accel 0.3
    scroll_method two_finger
    middle_emulation enabled
}
input "type:keyboard" {
    xkb_layout us
}

### Key bindings
bindsym $mod+Return exec $terminal
# floating terminal (class grabbed by the for_window rule below)
bindsym $mod+Shift+Return exec kitty --class floatterm
for_window [app_id="floatterm"] floating enable
bindsym $mod+E exec $fileManager
bindsym $mod+R exec $menu

bindsym $mod+Q kill
bindsym $mod+V floating toggle

# wallpaper / theme
bindsym $mod+W exec $HOME/.config/sway/scripts/wall-pick
bindsym $mod+Shift+W exec $HOME/.config/sway/scripts/theme-switch

# region screenshot -> file + clipboard
bindsym $mod+Shift+S exec bash -c 'mkdir -p "$HOME/Pictures/Screenshots/sway" && grim -g "$(slurp)" - | tee "$HOME/Pictures/Screenshots/sway/screenshot-$(date +%Y-%m-%d_%H%M%S).png" | wl-copy'

# quickshell menu
bindsym $mod+M exec quickshell ipc -p $HOME/.config/quickshell/bar call bar openPowerMenu
bindsym $mod+n exec quickshell ipc -p $HOME/.config/quickshell/bar call bar openNotifications
bindsym $mod+Shift+v exec quickshell ipc -p $HOME/.config/quickshell/bar call bar openClipboard
bindsym $mod+Shift+i exec quickshell ipc -p $HOME/.config/quickshell/bar call bar openSettings

bindsym $mod+J layout toggle split

# golden ratio spiral layout (optional arg = master %)
bindsym $mod+G exec $HOME/.config/sway/scripts/golden-layout

# focus, or resize floating windows (arrows)
bindsym $mod+Left exec $HOME/.config/sway/scripts/float-arrow left
bindsym $mod+Right exec $HOME/.config/sway/scripts/float-arrow right
bindsym $mod+Up exec $HOME/.config/sway/scripts/float-arrow up
bindsym $mod+Down exec $HOME/.config/sway/scripts/float-arrow down

# workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# scratchpad
bindsym $mod+S scratchpad show
bindsym $mod+Shift+minus move scratchpad

# scroll workspaces
bindsym $mod+button4 workspace prev
bindsym $mod+button5 workspace next

# move/resize floating windows by dragging (left=move, right=resize)
floating_modifier $mod normal

# reload / exit
bindsym $mod+Shift+R reload
bindsym $mod+Shift+X exec swaymsg exit

bindsym $mod+b exec quickshell ipc -p $HOME/.config/quickshell/bar call bar toggleBar
bindsym $mod+l exec $HOME/.config/sway/scripts/lock.sh

# screen recording (PrtSc key sends F10 on this laptop; Print kept as fallback)
bindsym $mod+F10 exec $HOME/.config/sway/scripts/rec-toggle.sh
bindsym $mod+Print exec $HOME/.config/sway/scripts/rec-toggle.sh

# fullscreen screenshot
bindsym $mod+Shift+F10 exec bash -c 'mkdir -p "$HOME/Pictures/Screenshots/sway" && grim - | tee "$HOME/Pictures/Screenshots/sway/screenshot-$(date +%Y-%m-%d_%H%M%S).png" | wl-copy'

# media keys (osd script flashes the level in the quickshell OSD)
bindsym XF86AudioRaiseVolume exec $HOME/.config/sway/scripts/osd volume up
bindsym XF86AudioLowerVolume exec $HOME/.config/sway/scripts/osd volume down
bindsym XF86AudioMute exec $HOME/.config/sway/scripts/osd volume mute
bindsym XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym XF86MonBrightnessUp exec $HOME/.config/sway/scripts/osd brightness up
bindsym XF86MonBrightnessDown exec $HOME/.config/sway/scripts/osd brightness down

bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPause exec playerctl play-pause
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioPrev exec playerctl previous

### Layout
gaps inner 5
gaps outer 30
default_border pixel 4
focus_follows_mouse yes

# SwayFX blur
blur enable
blur_xray disable
blur_passes 4
blur_radius 8
blur_noise 0.03
blur_brightness 1.0
blur_contrast 1.05
blur_saturation 1.1

# shadows (off on CSD windows, doesn't fit them)
shadows enable
shadows_on_csd disable
shadow_blur_radius 30
shadow_color #00000066
shadow_offset 0 6

# animations: open/close, move/resize, workspace switch (swayfx 0.6+).
# workspace transition is fade-only, no slide option exists.
animation_duration_ms 300

# theme-switch writes border colors, quickshell writes border/corner settings;
# both included last so they win.
include ~/.config/sway/theme-colors
include ~/.config/sway/settings.conf

### Window rules
for_window [title="^wallpaper-picker$"] floating enable, move position center
for_window [title="^power-menu$"] floating enable, move position center
for_window [title="^rofi$"] floating enable, move position center
for_window [app_id="^wallpaper-picker$"] border none
for_window [app_id="^power-menu$"] border none
for_window [app_id="^rofi$"] border none
# imv + kitty get a real titlebar; colors come from theme-colors (matugen bg,
# the same hex kitty uses for its terminal background)
for_window [app_id="^imv$"] border normal 1
for_window [app_id="^kitty$"] border normal 1

# thick lain-style titlebars (height = font height + 2 * vertical padding)
titlebar_padding 14 14

# zen popups/PiP get a pixel border
for_window [app_id="zen-beta" floating] border pixel 4

### Autostart
exec dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP
# required by xdg-desktop-portal
exec systemctl --user start sway-session.target
exec $HOME/.config/sway/scripts/quickshell-bar
exec $HOME/.config/sway/scripts/battery-notify
exec wl-paste --watch cliphist store
exec $HOME/.config/sway/scripts/theme-switch