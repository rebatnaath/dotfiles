#!/usr/bin/env bash
# Wall-pick: browse wallpapers with previews (quickshell) and apply via theme-switch.
set -euo pipefail

# Quickshell child processes get an almost-empty PATH (only the system
# profile), so python3/matugen/magick wouldn't resolve and the reload would
# fail silently. Repoint PATH at the home-manager profile that provides them.
case ":$PATH:" in
  *":/etc/profiles/per-user/$USER/bin:") ;;           # already present
  *) PATH="/etc/profiles/per-user/$USER/bin:$PATH" ;;
esac

WALLS="${WALLS_DIR:-$HOME/nixConfig/assets/walls}"
QS_CONF="$HOME/.config/quickshell/wallpaper-picker"
QS_BIN="$(command -v quickshell 2>/dev/null || true)"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
THUMBS="$HOME/.cache/wall-pick-thumbs"
LOG="$HOME/.cache/theme-switch.log"

mkdir -p "$THUMBS" "$QS_CONF"

# Generate landscape preview thumbnails for any wallpaper missing one, so
# newly added images render in the picker. Only the missing files are touched,
# so opening the picker stays instant once everything is cached.
magick_bin="$(command -v magick 2>/dev/null || echo 'nix run nixpkgs#imagemagick --')"
mapfile -d '' files < <(find "$WALLS" -maxdepth 2 -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) -print0 2>/dev/null)
missing=()
for f in "${files[@]}"; do
    [[ -f "$THUMBS/$(basename "$f")" ]] || missing+=("$f")
done
if ((${#missing[@]})); then
    $magick_bin mogrify -path "$THUMBS" -resize '480x270^' -gravity center -extent '480x270' "${missing[@]}" >/dev/null 2>&1 || true
fi

# current wallpaper (from the last theme-switch) -> mark that tile as "active"
ACTIVE=""
if [[ -f "$HOME/.cache/sway-theme.json" ]]; then
    ACTIVE="$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1])).get("wallpaper",""))' "$HOME/.cache/sway-theme.json" 2>/dev/null)"
fi

# Write the data file the picker reads (live list + absolute theme-switch path).
if ! WALLS="$WALLS" THUMBS="$THUMBS" ACTIVE="$ACTIVE" THEME_SWITCH="$SCRIPT_DIR/theme-switch" \
    JSON_OUT="$QS_CONF/picker-data.json" \
    python3 - > "$QS_CONF/picker.js" <<'PY'
import json, os

def js_str(s):
    return json.dumps(s)

wall_dir = os.environ["WALLS"]
thumbs = os.environ["THUMBS"]
candidates = []
for root, _, files in os.walk(wall_dir):
    for f in sorted(files):
        if f.lower().endswith((".png", ".jpg", ".jpeg", ".webp", ".gif")):
            full = os.path.join(root, f)
            candidates.append({
                "name": f,
                "path": full,
                "thumb": os.path.join(thumbs, f),
                # For search: the immediate parent dir name and the path
                # relative to the walls root, so e.g. walls/fox/main.jpg
                # matches a search for "fox" even though the file doesn't.
                "dir": os.path.basename(root),
                "rel": os.path.relpath(full, wall_dir),
            })

json_out = os.environ.get("JSON_OUT", "")
if json_out:
    with open(json_out, "w") as fh:
        json.dump({"active": os.environ.get("ACTIVE", ""),
                   "themeSwitch": os.environ["THEME_SWITCH"],
                   "walls": candidates}, fh)

print("// Generated by wall-pick -- do not edit by hand")
print(".pragma library")
print("var ACTIVE = " + js_str(os.environ.get("ACTIVE", "")) + ";")
print("var THEME_SWITCH = " + js_str(os.environ["THEME_SWITCH"]) + ";")
print("var WALLS = " + json.dumps(candidates, indent=2))
print("""
// Shared search matcher, used by both the QuickMenu wallpaper page and the
// standalone picker. Matches a wallpaper against a query by file name, the
// folder it lives in (dir) or its path relative to the walls root (rel), so
// e.g. all walls/fox/*.jpg match a search for \"fox\".
function matchesQuery(wall, query) {
    if (!query) return true
    var q = query.toLowerCase()
    if ((wall.name || \"\").toLowerCase().indexOf(q) >= 0) return true
    if ((wall.dir || \"\").toLowerCase().indexOf(q) >= 0) return true
    if ((wall.rel || \"\").toLowerCase().indexOf(q) >= 0) return true
    return false
}
""".strip())
PY
then
    echo "wall-pick: failed to generate picker data" >&2
    exit 1
fi

# Mirror the same data into the bar dir so the QuickMenu's wallpaper page
# (which imports it as a same-directory script) stays in sync.
cp "$QS_CONF/picker.js" "$HOME/.config/quickshell/bar/picker-data.js"

grep -q '"path"' "$QS_CONF/picker.js" || { echo "wall-pick: no wallpapers found in $WALLS" >&2; exit 1; }

# Non-interactive mode: regenerate thumbs + data, then print the JSON so the
# QuickMenu's wallpaper page can refresh at runtime (no picker is launched).
if [[ "${1:-}" == "--data-only" ]]; then
    exec python3 -c 'import json, sys; sys.stdout.write(json.dumps(json.load(open(sys.argv[1]))))' "$QS_CONF/picker-data.json"
fi

# Close any other quickshell popup already open (wallpaper picker, power menu,
# runner) so only one overlays the screen at a time.
for conf in wallpaper-picker powermenu runner; do
    pkill -f "quickshell/$conf" 2>/dev/null || true
done

# Prefer a real binary; fall back to the nix store so this works before any rebuild.
if [[ -z "$QS_BIN" ]]; then
    exec nix run nixpkgs#quickshell -- -p "$QS_CONF" 2>>"$LOG"
else
    exec "$QS_BIN" -p "$QS_CONF" 2>>"$LOG"
fi