#!/usr/bin/env bash
# Rice settings bridge: takes the quickshell rice settings and applies them to
# sway (window border/corner), kitty (font), and the QML token store that the
# bar / wallpaper-picker read back for live reactivity.
#
# Usage: rice-settings-apply <borderWidth> <cornerRadius> <barSide> <fontFamily>
#                            <barBorder> <barShadow> <quickMenuBorder> <quickMenuShadow>
#                            <osdBorder> <osdShadow>
#   borderWidth      int           sway window border thickness in px (0 = none)
#   cornerRadius     int           swayfx window corner radius in px
#   barSide          bottom|top    where the quickshell bar sits
#   fontFamily       string        global quickshell + kitty font
#   barBorder        true|false    accent border on the bar
#   barShadow        true|false    offset shadow on the bar
#   quickMenuBorder  true|false    accent border on the quick menu
#   quickMenuShadow  true|false    offset shadow on the quick menu
#   osdBorder        true|false    accent border on the OSD / notifications
#   osdShadow        true|false    offset shadow on the OSD / notifications
#   barFullWidth     true|false    stretch the bar edge-to-edge (no side gap)
#   activeBar        fox|lonely      which bar to show (fox = classic, lonely = accent)
#   nightLight       true|false    wlsunset night light on/off
#   noiseLevel       0|1..5        e-ink/e-paper grain intensity (0 = off)
set -euo pipefail

borderWidth="${1:-0}"
cornerRadius="${2:-0}"
barSide="${3:-bottom}"
fontFamily="${4:-GeistMono NFM}"
barBorder="${5:-true}"
barShadow="${6:-true}"
quickMenuBorder="${7:-true}"
quickMenuShadow="${8:-true}"
osdBorder="${9:-true}"
osdShadow="${10:-true}"
barFullWidth="${11:-false}"
activeBar="${12:-fox}"
nightLight="${13:-false}"
noiseLevel="${14:-0}"
nightLightIntensity="${15:-3}"

SETTINGS_JS="$HOME/.config/quickshell/bar/settings.js"
SWAY_SETTINGS_CONF="$HOME/.config/sway/settings.conf"
KITTY_CONF="$HOME/.config/kitty/kitty.conf"
# Previous active bar (settings.js is about to be overwritten), so a bar change
# can re-theme on the spot.
prevActiveBar="$(python3 -c 'import re;m=re.search(r"activeBar:\s*\"([^\"]*)\"",open("'$SETTINGS_JS'").read());print(m.group(1) if m else "fox")' 2>/dev/null || echo fox)"
mkdir -p "$(dirname "$SETTINGS_JS")" "$(dirname "$SWAY_SETTINGS_CONF")"

# -- sway block (included at the end of the sway config; last-write wins) --
if [[ "$borderWidth" -gt 0 ]]; then
    cat > "$SWAY_SETTINGS_CONF" <<EOF
# Generated by quickshell rice-settings -- do not edit by hand
default_border pixel ${borderWidth}
corner_radius ${cornerRadius}
EOF
else
    cat > "$SWAY_SETTINGS_CONF" <<EOF
# Generated by quickshell rice-settings -- do not edit by hand
default_border none
corner_radius ${cornerRadius}
EOF
fi

# -- QML token store (source for the bar + wallpaper-picker reactivity) --
cat > "$SETTINGS_JS" <<EOF
.pragma library
var SETTINGS = {
    borderWidth: ${borderWidth},
    cornerRadius: ${cornerRadius},
    barSide: "${barSide}",
    fontFamily: "${fontFamily}",
    barBorder: ${barBorder},
    barShadow: ${barShadow},
    quickMenuBorder: ${quickMenuBorder},
    quickMenuShadow: ${quickMenuShadow},
    osdBorder: ${osdBorder},
    osdShadow: ${osdShadow},
    barFullWidth: ${barFullWidth},
    activeBar: "${activeBar}",
    nightLight: ${nightLight},
    nightLightIntensity: ${nightLightIntensity},
    noiseLevel: ${noiseLevel},
}
EOF

# -- kitty: persist font + apply to running windows --
if [[ -f "$KITTY_CONF" ]]; then
    sed -i -E "s/^(font_family) .*/\1 ${fontFamily}/" "$KITTY_CONF"
fi
command -v kitty >/dev/null && kitty @ set-font-family "$fontFamily" >/dev/null 2>&1 || true

# -- night light: apply wlsunset per the persisted setting --
nightlight_script="$HOME/.config/sway/scripts/nightlight-toggle"
if [[ -x "$nightlight_script" ]]; then
    if [[ "$nightLight" == "true" ]]; then
        "$nightlight_script" on "$nightLightIntensity" >/dev/null 2>&1 || true
    else
        "$nightlight_script" off >/dev/null 2>&1 || true
    fi
fi

# -- reload sway: corner_radius is renderer-global (instant for all windows) --
swaymsg reload >/dev/null 2>&1 || true

# default_border only affects NEW windows; reprocess existing apps' borders so
# the change is visible immediately.
if [[ "$borderWidth" -gt 0 ]]; then
    swaymsg '[] border pixel '"$borderWidth" >/dev/null 2>&1 || true
else
    swaymsg '[] border none' >/dev/null 2>&1 || true
fi

# Push the fresh settings.js to the running bar / quick menu immediately via IPC.
# The bar also polls every 400ms as a fallback, but this removes the lag and
# avoids relying on the poll timer right after a change.
quickshell ipc -p "$HOME/.config/quickshell/bar" call bar reloadSettings >/dev/null 2>&1 || true

echo "applied: border=${borderWidth}px corner=${cornerRadius}px bar=${barSide} font=${fontFamily} bar=${barBorder}/${barShadow} qmenu=${quickMenuBorder}/${quickMenuShadow} osd=${osdBorder}/${osdShadow} fullwidth=${barFullWidth} active=${activeBar} night=${nightLight}/${nightLightIntensity}% noise=${noiseLevel}"