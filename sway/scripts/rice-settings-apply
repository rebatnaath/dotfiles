#!/usr/bin/env bash
# Rice settings bridge: reads settings.js and applies them to sway, kitty,
# and wlsunset. QML writes settings.js first, then calls this script.
#
# Usage: rice-settings-apply
export PATH="/run/current-system/sw/bin:/etc/profiles/per-user/oryza/bin:$PATH"
export SWAYSOCK="${SWAYSOCK:-/run/user/$(id -u)/sway-ipc.$(id -u).$(pgrep -x sway || echo 0).sock}"
set -euo pipefail

SETTINGS_JS="$HOME/.config/quickshell/bar/settings.js"
SWAY_SETTINGS_CONF="$HOME/.config/sway/settings.conf"
KITTY_CONF="$HOME/.config/kitty/kitty.conf"

# read values from settings.js
read_val() { python3 -c "import re;print(re.search(r'$1:\s*(.+?)[,\n]',open('$SETTINGS_JS').read()).group(1).strip().strip('\"'))" 2>/dev/null || echo "$2"; }

borderWidth="$(read_val borderWidth 4)"
cornerRadius="$(read_val cornerRadius 0)"
innerRadius="$(read_val innerRadius 4)"
barSide="$(read_val barSide top)"
fontFamily="$(read_val fontFamily 'GeistMono NFM')"
barBorder="$(read_val barBorder true)"
barShadow="$(read_val barShadow true)"
quickMenuBorder="$(read_val quickMenuBorder true)"
quickMenuShadow="$(read_val quickMenuShadow true)"
osdBorder="$(read_val osdBorder true)"
osdShadow="$(read_val osdShadow true)"
barFullWidth="$(read_val barFullWidth true)"
activeBar="$(read_val activeBar fox)"
nightLight="$(read_val nightLight false)"
nightLightIntensity="$(read_val nightLightIntensity 3)"
noiseLevel="$(read_val noiseLevel 0)"

mkdir -p "$(dirname "$SWAY_SETTINGS_CONF")"

# -- sway block --
if [[ "$borderWidth" -gt 0 ]]; then
    cat > "$SWAY_SETTINGS_CONF" <<EOF
# Generated by quickshell rice-settings -- do not edit by hand
default_border pixel ${borderWidth}
corner_radius ${cornerRadius}
EOF
else
    cat > "$SWAY_SETTINGS_CONF" <<EOF
# Generated by quickshell rice-settings -- do not edit by hand
default_border none
corner_radius ${cornerRadius}
EOF
fi

# -- kitty: persist font + apply to running windows --
if [[ -f "$KITTY_CONF" ]]; then
    sed -i -E "s/^(font_family) .*/\1 ${fontFamily}/" "$KITTY_CONF"
fi
command -v kitty >/dev/null && kitty @ set-font-family "$fontFamily" >/dev/null 2>&1 || true

# -- night light: apply wlsunset per the persisted setting --
nightlight_script="$HOME/.config/sway/scripts/nightlight-toggle"
if [[ -x "$nightlight_script" ]]; then
    if [[ "$nightLight" == "true" ]]; then
        "$nightlight_script" on "$nightLightIntensity" >/dev/null 2>&1 || true
    else
        "$nightlight_script" off >/dev/null 2>&1 || true
    fi
fi

# apply corner_radius: swayfx only applies this from config on reload,
# not via runtime IPC to existing windows. settings.conf is already written
# above; swaymsg reload will re-read it and re-apply to all windows.
# border can be applied at runtime to existing windows:
if [[ "$borderWidth" -gt 0 ]]; then
    swaymsg '[class=".*"] border pixel '"$borderWidth" >/dev/null 2>&1 || true
else
    swaymsg '[class=".*"] border none' >/dev/null 2>&1 || true
fi

# reload sway to pick up corner_radius (and default_border) from settings.conf
swaymsg reload >/dev/null 2>&1 || true

echo "applied: border=${borderWidth}px corner=${cornerRadius}px bar=${barSide} font=${fontFamily}"
