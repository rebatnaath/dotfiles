#!/usr/bin/env bash
# Persist noise level + apply it seamlessly, WITHOUT the full
# rice-settings-apply (no sway reload, no kitty/border reprocessing).
# The noise overlay in the bar reads root.noiseLevel from settings.js,
# so we only need to update that value in-place.
#
# Usage: noise-apply [0-5]
export PATH="/run/current-system/sw/bin:/etc/profiles/per-user/oryza/bin:$PATH"
set -uo pipefail

LEVEL="${1:-0}"
LEVEL=$(( LEVEL > 5 ? 5 : (LEVEL < 0 ? 0 : LEVEL) ))

SETTINGS_JS="$HOME/.config/quickshell/bar/settings.js"

python3 - "$LEVEL" "$SETTINGS_JS" <<'PY'
import re, sys
level, path = int(sys.argv[1]), sys.argv[2]
level = max(0, min(5, level))
s = open(path).read()
s = re.sub(r'(\s*noiseLevel\s*:\s*)\d+(,)',
           lambda m: m.group(1) + str(level) + m.group(2), s, count=1)
open(path, "w").write(s)
PY
